# SMTP (for sending emails via Nodemailer)
SMTP_HOST=smtp.your-agency.gov.sg
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=secretariat@your-agency.gov.sg

# Opus Email Trigger Addresses
# Copy these from your Opus workflow's Email Trigger Node settings panel
OPUS_AGENDA_TRIGGER_EMAIL=default-staging+<your-workflow-agenda-address>@ci.opus
OPUS_MINUTES_TRIGGER_EMAIL=default-staging+<your-workflow-minutes-address>@ci.opus

# Anthropic (for AI transcript summarisation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App
PORT=3000
NODE_ENV=production
